<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Snake</title>

    <style>
        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background: #12263a;
        }

        body {
            display: flex;
            justify-content: center;
            align-items: center;
            touch-action: none;
        }

        canvas {
            display: block;
            background: #12263a;
            touch-action: none;
        }
    </style>
</head>

<body>

<canvas id="canvas"></canvas>

<script>
const canvas = document.getElementById("canvas");
const ctx = canvas.getContext("2d");

// Original settings
const WIDE = 800;
const HIGH = 600;
const GAP = 14;
const SPEED = 4;
const TURN = 0.15;
const NEAR = 30;
const BEND = Math.PI / 8;
const QUARTER = Math.PI / 2;
const WATER = "#12263a";

const WIDTHS = [
    18, 20, 17, 16, 16, 16, 16, 16,
    16, 16, 16, 15, 15, 15, 14, 14,
    13, 13, 12, 12, 11, 10, 9, 8,
    7, 6, 5, 4
];

// Scale the game to fit the phone screen
let scale = 1;
let offsetX = 0;
let offsetY = 0;

function resizeCanvas() {
    const screenWidth = window.innerWidth;
    const screenHeight = window.innerHeight;

    scale = Math.min(screenWidth / WIDE, screenHeight / HIGH);

    canvas.width = screenWidth;
    canvas.height = screenHeight;

    offsetX = (screenWidth - WIDE * scale) / 2;
    offsetY = (screenHeight - HIGH * scale) / 2;
}

resizeCanvas();
window.addEventListener("resize", resizeCanvas);


// Convert screen coordinates into game coordinates
function getGamePosition(clientX, clientY) {
    return [
        (clientX - offsetX) / scale,
        (clientY - offsetY) / scale
    ];
}


// Angle from one point to another
function angleTo(start, end) {
    return Math.atan2(
        end[1] - start[1],
        end[0] - start[0]
    );
}


// Walk from a point in a direction
function walk(start, angle, far) {
    return [
        start[0] + Math.cos(angle) * far,
        start[1] + Math.sin(angle) * far
    ];
}


// Limit how much an angle can change
function limit(angle, middle, most) {
    let away =
        (angle - middle + Math.PI) %
        (2 * Math.PI) - Math.PI;

    if (away > most) {
        return middle + most;
    }

    if (away < -most) {
        return middle - most;
    }

    return angle;
}


class Snake {

    constructor() {

        this.mouse = [
            WIDE / 2,
            HIGH / 2
        ];

        this.points = [];
        this.angles = [];

        // Start as a straight line
        for (let i = 0; i < WIDTHS.length; i++) {

            this.points.push([
                WIDE / 2 - i * GAP,
                HIGH / 2
            ]);

            this.angles.push(0);
        }
    }


    move() {

        const head = this.points[0];

        const distance = Math.hypot(
            head[0] - this.mouse[0],
            head[1] - this.mouse[1]
        );

        // Stop when the snake gets close enough
        if (distance < NEAR) {
            return;
        }

        // Head turns toward the target
        const wanted = angleTo(
            head,
            this.mouse
        );

        this.angles[0] = limit(
            wanted,
            this.angles[0],
            TURN
        );

        // Move head
        this.points[0] = walk(
            head,
            this.angles[0],
            SPEED
        );


        // Move every body segment
        for (let i = 1; i < WIDTHS.length; i++) {

            const wanted = angleTo(
                this.points[i],
                this.points[i - 1]
            );

            this.angles[i] = limit(
                wanted,
                this.angles[i - 1],
                BEND
            );

            this.points[i] = walk(
                this.points[i - 1],
                this.angles[i],
                -GAP
            );
        }
    }


    outline() {

        const left = [];
        const right = [];

        for (let i = 0; i < WIDTHS.length; i++) {

            left.push(
                walk(
                    this.points[i],
                    this.angles[i] - QUARTER,
                    WIDTHS[i]
                )
            );

            right.push(
                walk(
                    this.points[i],
                    this.angles[i] + QUARTER,
                    WIDTHS[i]
                )
            );
        }

        right.reverse();

        const nose = walk(
            this.points[0],
            this.angles[0],
            WIDTHS[0]
        );

        return [nose, ...left, ...right];
    }


    draw() {

        ctx.clearRect(
            0,
            0,
            canvas.width,
            canvas.height
        );

        // Draw the game area
        ctx.save();

        ctx.translate(
            offsetX,
            offsetY
        );

        ctx.scale(
            scale,
            scale
        );


        // Snake body
        const outline = this.outline();

        ctx.beginPath();

        ctx.moveTo(
            outline[0][0],
            outline[0][1]
        );

        for (let i = 1; i < outline.length; i++) {
            ctx.lineTo(
                outline[i][0],
                outline[i][1]
            );
        }

        ctx.closePath();

        ctx.fillStyle = "#ee6c4d";
        ctx.fill();

        ctx.strokeStyle = "white";
        ctx.lineWidth = 3;
        ctx.stroke();


        // Eyes
        const head = this.points[0];
        const facing = this.angles[0];

        const leftEye = walk(
            head,
            facing - 1.2,
            9
        );

        const rightEye = walk(
            head,
            facing + 1.2,
            9
        );

        drawCircle(
            leftEye,
            3,
            "white"
        );

        drawCircle(
            rightEye,
            3,
            "white"
        );

        ctx.restore();
    }
}


function drawCircle(position, radius, color) {

    ctx.beginPath();

    ctx.arc(
        position[0],
        position[1],
        radius,
        0,
        Math.PI * 2
    );

    ctx.fillStyle = color;
    ctx.fill();
}


// Create snake
const snake = new Snake();


// Mouse control
canvas.addEventListener("mousemove", function(event) {

    snake.mouse = getGamePosition(
        event.clientX,
        event.clientY
    );

});


// Touch control for phones
canvas.addEventListener("touchstart", function(event) {

    event.preventDefault();

    const touch = event.touches[0];

    snake.mouse = getGamePosition(
        touch.clientX,
        touch.clientY
    );

}, { passive: false });


canvas.addEventListener("touchmove", function(event) {

    event.preventDefault();

    const touch = event.touches[0];

    snake.mouse = getGamePosition(
        touch.clientX,
        touch.clientY
    );

}, { passive: false });


// Game loop
function frame() {

    snake.move();
    snake.draw();

    requestAnimationFrame(frame);
}

frame();

</script>

</body>
</html>
